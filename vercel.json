{
  "buildCommand": "npm run build",
  "functions": {
    "api/ai-chat.js": {
      "maxDuration": 30
    },
    "api/wisp.js": {
      "maxDuration": 300,
      "excludeFiles": "{Public,curl-master,curl-curl-8_22_0,scramjet-2.0.67-alpha.2,html-main,tests}/**"
    },
    "api/remote.js": {
      "maxDuration": 15,
      "excludeFiles": "{Public,remote-agent,tests}/**"
    },
    "api/fortnite.js": {
      "maxDuration": 120,
      "excludeFiles": "{Public,remote-agent,tests}/**"
    },
    "api/music-search.js": {
      "maxDuration": 30,
      "excludeFiles": "{Public,remote-agent,tests}/**"
    },
    "api/soundcloud.js": {
      "maxDuration": 30,
      "excludeFiles": "{Public,remote-agent,tests}/**"
    },
    "api/novatube.js": {
      "maxDuration": 30,
      "excludeFiles": "{Public,remote-agent,tests}/**"
    }
  },
  "outputDirectory": "Public",
  "installCommand": "npm ci --ignore-scripts",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/~/sj/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/game-runtime/fortnite18/:path*",
      "destination": "/api/fortnite?path=:path*"
    },
    {
      "destination": "/api/account?novaEndpoint=account-login",
      "source": "/api/account-login"
    },
    {
      "destination": "/api/account?novaEndpoint=login-handoff",
      "source": "/api/login-handoff"
    },
    {
      "destination": "/api/account?novaEndpoint=secure-appeal",
      "source": "/api/secure-appeal"
    },
    {
      "source": "/computer",
      "destination": "/computer.html"
    }
  ]
}
