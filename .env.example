# Environment Variables Example
# Copy this file to .env if you need custom configuration

# Server Port (default: 3000)
PORT=3000

# Node Environment (development or production)
NODE_ENV=production

# Optional: Custom Bare Server Path
# BARE_PATH=/bare/

# Nova Chat: private one-time owner setup. Use a long random code, never a public frontend value.
# NOVA_CHAT_OWNER_CODE=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared login: the primary handles sign-in and user approval for new HTTPS copies.
# Optional: NOVA_LOGIN_USER_APPROVAL=false restores administrator allowlisting.
# HTTPS origins only, without paths or a trailing slash. No wildcard domains.
NOVA_LOGIN_ORIGIN=https://novaoffical.vercel.app
# Add the exact new site address here when it is ready (comma-separated).
# NOVA_LOGIN_TRUSTED_ORIGINS=https://your-new-nova-domain.example

# Current ExpressTURN free relay. Keep account credentials in server environment variables.
NOVA_TURN_URL=turn:free.expressturn.com:3478,turn:free.expressturn.com:3478?transport=tcp
NOVA_TURN_USERNAME=
NOVA_TURN_CREDENTIAL=

# Nova Computer has a separate TURN configuration (owner/admin access only).
# Copy the actual TURN URLs, username and credential from its Metered credential.
NOVA_COMPUTER_TURN_URL=
NOVA_COMPUTER_TURN_USERNAME=
NOVA_COMPUTER_TURN_CREDENTIAL=
# Optional coturn REST signing secret; leave unset for static Metered credentials.
# NOVA_COMPUTER_TURN_SECRET=
