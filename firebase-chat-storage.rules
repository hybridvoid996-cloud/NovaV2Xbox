rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /server-images/{uid}/{image} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.size > 0
    && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
   allow delete: if request.auth != null && request.auth.uid == uid;
  }
  match /chat-videos/{uid}/{video} {
   // Download links are shared in chat; only the uploader can change the file.
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.size > 0 && request.resource.size <= 250 * 1024 * 1024
    && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
   allow delete: if request.auth != null && request.auth.uid == uid;
  }
 }
}
