{
  "name": "nova-remote",
  "version": "0.3.5",
  "private": true,
  "description": "Visible, account-authorized Nova Windows remote desktop agent",
  "author": "Nova",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:msi": "electron-builder --win msi --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.nova.remote",
    "productName": "Nova Remote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "session-state.cjs",
      "capture-permission.cjs",
      "preload.cjs",
      "agent.html",
      "agent.css",
      "renderer.js",
      "input.ps1",
      "nova.png",
      "update-service.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "nova.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NovaRemote.exe",
      "runAfterFinish": true,
      "installerIcon": "nova.ico",
      "uninstallerIcon": "nova.ico"
    },
    "compression": "maximum",
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "NovaRemote.msi",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
